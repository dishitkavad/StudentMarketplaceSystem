@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">

    <h1>Admin Dashboard</h1>

    <hr />

    <div class="alert alert-success">
        <strong>Welcome, Admin!</strong>
        You have successfully accessed the Admin Dashboard.
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">

            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">
                        Users
                    </h5>

                    <p class="card-text">
                        Manage registered students.
                    </p>

                    <button class="btn btn-primary" disabled>
                        Manage Users
                    </button>

                </div>
            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">
                        Products
                    </h5>

                    <p class="card-text">
                        Manage marketplace products.
                    </p>

                    <button class="btn btn-primary" disabled>
                        Manage Products
                    </button>

                </div>
            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">
                        Reports
                    </h5>

                    <p class="card-text">
                        View and manage reported content.
                    </p>

                    <button class="btn btn-primary" disabled>
                        View Reports
                    </button>

                </div>
            </div>

        </div>

    </div>

</div>