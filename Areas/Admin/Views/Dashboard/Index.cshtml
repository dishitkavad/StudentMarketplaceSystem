
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Manage and monitor the Student Marketplace.
            </p>
        </div>

        <a href="/"
           class="btn btn-outline-secondary">
            ← Back to Home
        </a>
    </div>

    <!-- WELCOME -->
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 fs-3">
                👋
            </div>

            <div>
                <h5 class="mb-1 fw-bold">Welcome, Admin!</h5>
                <p class="mb-0">
                    You have successfully accessed the Admin Dashboard.
                    Choose an option below to manage the marketplace.
                </p>
            </div>
        </div>
    </div>

    <!-- ADMIN OPTIONS -->
    <div class="row g-4">

        <!-- USERS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="mb-3 fs-1">
                        👥
                    </div>

                    <h4 class="fw-bold">
                        Users
                    </h4>

                    <p class="text-muted">
                        Manage registered students and control user access
                        to the marketplace.
                    </p>

                    <a href="/Admin/Users"
                       class="btn btn-primary w-100">
                        Manage Users
                    </a>

                </div>
            </div>
        </div>

        <!-- PRODUCTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="mb-3 fs-1">
                        📦
                    </div>

                    <h4 class="fw-bold">
                        Products
                    </h4>

                    <p class="text-muted">
                        View and manage products listed by students
                        in the marketplace.
                    </p>

                    <a href="/Admin/Products"
                       class="btn btn-primary w-100">
                        Manage Products
                    </a>

                </div>
            </div>
        </div>

        <!-- REPORTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="mb-3 fs-1">
                        🚩
                    </div>

                    <h4 class="fw-bold">
                        Reports
                    </h4>

                    <p class="text-muted">
                        Review reported products and users and
                        manage reported content.
                    </p>

                    <a href="/Admin/Reports"
                       class="btn btn-primary w-100">
                        View Reports
                    </a>

                </div>
            </div>
        </div>

        <!-- STATISTICS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="mb-3 fs-1">
                        📊
                    </div>

                    <h4 class="fw-bold">
                        Statistics
                    </h4>

                    <p class="text-muted">
                        View important marketplace statistics and
                        activity information.
                    </p>

                    <a href="/Admin/Statistics"
                       class="btn btn-primary w-100">
                        View Statistics
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- FOOTER INFO -->
    <div class="text-center mt-5">
        <p class="text-muted small mb-0">
            Student Marketplace System • Admin Panel
        </p>
    </div>

</div>
