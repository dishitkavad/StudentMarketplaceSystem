@model StudentMarketplaceSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";

    var currentUserId =
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var isOwner = currentUserId == Model.UserId;
}

<div class="container">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Product Details</h1>
            <p class="text-muted mb-0">
                View complete information about this product.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Products
        </a>
    </div>

    <!-- MESSAGES -->
    @if (TempData["TransactionMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["TransactionMessage"]
        </div>
    }

    @if (TempData["ReportMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["ReportMessage"]
        </div>
    }

    <div class="row g-4">

        <!-- PRODUCT INFORMATION -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <!-- TITLE AND STATUS -->
                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>
                            <h2 class="fw-bold mb-1">
                                @Model.Title
                            </h2>

                            <p class="text-muted mb-0">
                                Posted on
                                @Model.CreatedDate.ToString("dd-MM-yyyy")
                            </p>
                        </div>

                        @if (Model.IsSold)
                        {
                            <span class="badge bg-danger fs-6">
                                Sold
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">
                                Available
                            </span>
                        }

                    </div>

                    <hr />

                    <!-- PRICE -->
                    <div class="mb-4">
                        <h3 class="text-success fw-bold">
                            ₹@Model.Price.ToString("N2")
                        </h3>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="mb-4">

                        <h5 class="fw-bold">
                            Description
                        </h5>

                        <p class="text-muted">
                            @Model.Description
                        </p>

                    </div>

                    <!-- PRODUCT INFORMATION -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Category
                                </small>

                                <div class="fw-semibold">
                                    @Model.Category
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Condition
                                </small>

                                <div class="fw-semibold">
                                    @Model.Condition
                                </div>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <!-- ACTIONS -->
                    <div class="mt-3">

                        @if (isOwner)
                        {
                            <div class="alert alert-light border">
                                <strong>This is your product.</strong>
                                You can manage it using the options below.
                            </div>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="Product"
                                   asp-action="Edit"
                                   asp-route-id="@Model.ProductId"
                                   class="btn btn-primary">
                                    Edit Product
                                </a>

                                <a asp-controller="Product"
                                   asp-action="Delete"
                                   asp-route-id="@Model.ProductId"
                                   class="btn btn-outline-danger">
                                    Delete Product
                                </a>

                                @if (!Model.IsSold)
                                {
                                    <form asp-controller="Product"
                                          asp-action="MarkAsSold"
                                          asp-route-id="@Model.ProductId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-success">
                                            Mark as Sold
                                        </button>

                                    </form>
                                }

                            </div>
                        }
                        else
                        {
                            @if (!Model.IsSold)
                            {
                                <form asp-controller="Transaction"
                                      asp-action="Buy"
                                      asp-route-id="@Model.ProductId"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-success btn-lg">
                                        Interested / Buy
                                    </button>

                                </form>
                            }
                            else
                            {
                                <div class="alert alert-secondary">
                                    This product has already been sold.
                                </div>
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Report"
                                   asp-action="CreateProduct"
                                   asp-route-productId="@Model.ProductId"
                                   class="btn btn-outline-danger">
                                    Report Product
                                </a>
                            }
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- SELLER INFORMATION -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-3">
                        Seller Information
                    </h4>

                    <div class="border rounded p-3 mb-3">

                        <div class="mb-2">
                            <small class="text-muted">
                                Seller Name
                            </small>

                            <div class="fw-semibold">
                                @Model.Seller?.Name
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Seller?.Branch))
                        {
                            <div class="mb-2">

                                <small class="text-muted">
                                    Branch
                                </small>

                                <div class="fw-semibold">
                                    @Model.Seller.Branch
                                </div>

                            </div>
                        }

                        @if (Model.Seller?.Year > 0)
                        {
                            <div>

                                <small class="text-muted">
                                    Year
                                </small>

                                <div class="fw-semibold">
                                    @Model.Seller.Year
                                </div>

                            </div>
                        }

                    </div>

                    @if (!isOwner && User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Report"
                           asp-action="CreateUser"
                           asp-route-userId="@Model.UserId"
                           class="btn btn-outline-danger w-100">
                            Report Seller
                        </a>
                    }

                </div>

            </div>

            <!-- QUICK INFORMATION -->
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Quick Information
                    </h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">
                            Category
                        </span>
                        <strong>
                            @Model.Category
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">
                            Condition
                        </span>
                        <strong>
                            @Model.Condition
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">
                            Status
                        </span>

                        @if (Model.IsSold)
                        {
                            <strong class="text-danger">
                                Sold
                            </strong>
                        }
                        else
                        {
                            <strong class="text-success">
                                Available
                            </strong>
                        }
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- BOTTOM NAVIGATION -->
    <div class="mt-4">

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-secondary">
            ← Back to Products
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Home
        </a>

    </div>

</div>