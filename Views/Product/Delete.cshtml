
@model StudentMarketplaceSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container">

    <h1>Delete Product</h1>

    <hr />

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this product?</strong>
        <br />
        This action cannot be undone.
    </div>

    <div class="card">

        <div class="card-body">

            <h3>
                @Model.Title
            </h3>

            <hr />

            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Price:</strong>
                ₹@Model.Price
            </p>

            <p>
                <strong>Category:</strong>
                @Model.Category
            </p>

            <p>
                <strong>Condition:</strong>
                @Model.Condition
            </p>

            <p>
                <strong>Seller:</strong>
                @Model.Seller?.Name
            </p>

            <hr />

            <form asp-controller="Product"
                  asp-action="Delete"
                  asp-route-id="@Model.ProductId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Product
                </button>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
