@model StudentMarketplaceSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Delete Product</h1>

            <p class="text-muted mb-0">
                Confirm that you want to remove this product.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="MyProducts"
           class="btn btn-outline-secondary">
            ← My Products
        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- WARNING -->
            <div class="alert alert-danger shadow-sm">

                <h5 class="fw-bold">
                    ⚠ Are you sure?
                </h5>

                <p class="mb-0">
                    You are about to permanently delete this product.
                    This action cannot be undone.
                </p>

            </div>

            <!-- PRODUCT CARD -->
            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        @Model.Title
                    </h3>

                    <hr />

                    <!-- DESCRIPTION -->
                    <div class="mb-3">

                        <small class="text-muted">
                            Description
                        </small>

                        <p class="mb-0">
                            @Model.Description
                        </p>

                    </div>

                    <!-- PRICE -->
                    <div class="mb-3">

                        <small class="text-muted">
                            Price
                        </small>

                        <h4 class="text-success fw-bold">
                            ₹@Model.Price.ToString("N2")
                        </h4>

                    </div>

                    <!-- CATEGORY -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <small class="text-muted">
                                Category
                            </small>

                            <div class="fw-semibold">
                                @Model.Category
                            </div>

                        </div>

                        <!-- CONDITION -->
                        <div class="col-md-6 mb-3">

                            <small class="text-muted">
                                Condition
                            </small>

                            <div class="fw-semibold">
                                @Model.Condition
                            </div>

                        </div>

                    </div>

                    <!-- SELLER -->
                    <div class="mb-3">

                        <small class="text-muted">
                            Seller
                        </small>

                        <div class="fw-semibold">
                            @Model.Seller?.Name
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- ACTIONS -->
                    <form asp-controller="Product"
                          asp-action="Delete"
                          asp-route-id="@Model.ProductId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                Yes, Delete Product
                            </button>

                            <a asp-controller="Product"
                               asp-action="MyProducts"
                               class="btn btn-secondary px-4">
                                Cancel
                            </a>

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@Model.ProductId"
                               class="btn btn-outline-secondary px-4">
                                Back to Details
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>