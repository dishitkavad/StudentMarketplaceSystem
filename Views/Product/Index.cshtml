
@model IEnumerable<StudentMarketplaceSystem.Models.Product>

@{
    ViewData["Title"] = "Browse Products";

    var currentUserId =
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Browse Products
            </h1>

            <p class="text-muted mb-0">
                Find useful products from fellow students.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            ← Home

        </a>

    </div>


    <!-- SEARCH AND FILTERS -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h5 class="card-title mb-3">
                Search & Filter
            </h5>

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row">

                    <!-- SEARCH -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by product title..." />

                    </div>


                    <!-- CATEGORY -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Category
                        </label>

                        <select name="category"
                                class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            <option value="Books & Notes"
                                    selected="@(ViewBag.Category == "Books & Notes")">
                                Books & Notes
                            </option>

                            <option value="Electronics"
                                    selected="@(ViewBag.Category == "Electronics")">
                                Electronics
                            </option>

                            <option value="Engineering Equipment"
                                    selected="@(ViewBag.Category == "Engineering Equipment")">
                                Engineering Equipment
                            </option>

                            <option value="Furniture"
                                    selected="@(ViewBag.Category == "Furniture")">
                                Furniture
                            </option>

                            <option value="Clothing"
                                    selected="@(ViewBag.Category == "Clothing")">
                                Clothing
                            </option>

                            <option value="Sports"
                                    selected="@(ViewBag.Category == "Sports")">
                                Sports
                            </option>

                            <option value="Stationery"
                                    selected="@(ViewBag.Category == "Stationery")">
                                Stationery
                            </option>

                            <option value="Other"
                                    selected="@(ViewBag.Category == "Other")">
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- SORT -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Sort By
                        </label>

                        <select name="sort"
                                class="form-select">

                            <option value="">
                                Newest First
                            </option>

                            <option value="oldest"
                                    selected="@(ViewBag.Sort == "oldest")">
                                Oldest First
                            </option>

                            <option value="price_low"
                                    selected="@(ViewBag.Sort == "price_low")">
                                Price: Low to High
                            </option>

                            <option value="price_high"
                                    selected="@(ViewBag.Sort == "price_high")">
                                Price: High to Low
                            </option>

                        </select>

                    </div>


                    <!-- FILTER BUTTONS -->

                    <div class="col-md-2 mb-3 d-flex align-items-end">

                        <div class="w-100">

                            <button type="submit"
                                    class="btn btn-primary w-100 mb-2">

                                Apply Filters

                            </button>

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-outline-secondary w-100">

                                Clear

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- FILTER RESULT MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.Search) ||
             !string.IsNullOrWhiteSpace(ViewBag.Category) ||
             !string.IsNullOrWhiteSpace(ViewBag.Sort))
    {
        <div class="alert alert-info">

            <strong>Filters Applied:</strong>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <span class="ms-2">
                    Search: <strong>@ViewBag.Search</strong>
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(ViewBag.Category))
            {
                <span class="ms-2">
                    Category: <strong>@ViewBag.Category</strong>
                </span>
            }

            @if (ViewBag.Sort == "oldest")
            {
                <span class="ms-2">
                    Sort: <strong>Oldest First</strong>
                </span>
            }
            else if (ViewBag.Sort == "price_low")
            {
                <span class="ms-2">
                    Sort: <strong>Price: Low to High</strong>
                </span>
            }
            else if (ViewBag.Sort == "price_high")
            {
                <span class="ms-2">
                    Sort: <strong>Price: High to Low</strong>
                </span>
            }
            else
            {
                <span class="ms-2">
                    Sort: <strong>Newest First</strong>
                </span>
            }

        </div>
    }


    <!-- PRODUCT COUNT -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="mb-0">
            Available Products
        </h4>

        <span class="badge bg-secondary">
            @Model.Count() product(s)
        </span>

    </div>


    <!-- PRODUCTS -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <div class="fs-1 mb-3">
                    📦
                </div>

                <h4>
                    No Products Found
                </h4>

                <p class="text-muted">
                    Try changing your search or filter options.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary">

                    View All Products

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var product in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">


                            <!-- TITLE -->

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h5 class="card-title fw-bold mb-0">

                                    @product.Title

                                </h5>


                                @if (product.IsSold)
                                {
                                    <span class="badge bg-danger">
                                        Sold
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }

                            </div>


                            <!-- DESCRIPTION -->

                            <p class="card-text text-muted">

                                @if (product.Description.Length > 120)
                                {
                                    @product.Description.Substring(0, 120)

                                    <span>...</span>
                                }
                                else
                                {
                                    @product.Description
                                }

                            </p>


                            <!-- PRICE -->

                            <h4 class="text-primary fw-bold">
                                ₹@product.Price
                            </h4>


                            <!-- PRODUCT INFORMATION -->

                            <div class="mb-3">

                                <p class="mb-1">
                                    <strong>Category:</strong>
                                    @product.Category
                                </p>

                                <p class="mb-1">
                                    <strong>Condition:</strong>
                                    @product.Condition
                                </p>

                                <p class="mb-1">
                                    <strong>Seller:</strong>
                                    @product.Seller?.Name
                                </p>

                                <p class="mb-0 text-muted small">
                                    Posted:
                                    @product.CreatedDate.ToString("dd-MM-yyyy")
                                </p>

                            </div>


                            <hr />


                            <!-- ACTION BUTTONS -->

                            <div class="mt-auto">

                                <!-- VIEW DETAILS -->

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-primary w-100 mb-2">

                                    View Details

                                </a>


                                <!-- WISHLIST -->
                                @if (!product.IsSold &&
                                                                     product.UserId != currentUserId)
                                {
                                    <form asp-controller="Wishlist"
                                          asp-action="Add"
                                          asp-route-id="@product.ProductId"
                                          method="post"
                                          class="mb-2">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100">

                                            ❤️ Add to Wishlist

                                        </button>

                                    </form>
                                }


                                <!-- OWNER CONTROLS -->
                                @if (product.UserId == currentUserId)
                                {
                                    <div class="border-top pt-2 mt-2">

                                        <p class="small text-muted mb-2">
                                            Your Product
                                        </p>


                                        <div class="d-flex gap-2">

                                            <a asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-warning flex-fill">

                                                Edit

                                            </a>

                                            <a asp-controller="Product"
                                               asp-action="Delete"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-danger flex-fill">

                                                Delete

                                            </a>

                                        </div>


                                        @if (!product.IsSold)
                                        {
                                            <form asp-controller="Product"
                                                  asp-action="MarkAsSold"
                                                  asp-route-id="@product.ProductId"
                                                  method="post"
                                                  class="mt-2">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-success w-100">

                                                    ✓ Mark as Sold

                                                </button>

                                            </form>
                                        }

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
