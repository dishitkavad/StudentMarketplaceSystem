@model IEnumerable<StudentMarketplaceSystem.Models.Transaction>

@{
    ViewData["Title"] = "Buy Requests";
}

<div class="container">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Buy Requests</h1>

            <p class="text-muted mb-0">
                Manage requests from students interested in your products.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="MyProducts"
           class="btn btn-primary">
            My Products
        </a>

    </div>

    <!-- TRANSACTION MESSAGE -->
    @if (TempData["TransactionMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["TransactionMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <!-- EMPTY STATE -->
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <h3 class="fw-bold">
                    No Buy Requests
                </h3>

                <p class="text-muted">
                    You don't have any buy requests for your products yet.
                </p>

                <div class="mt-3">

                    <a asp-controller="Product"
                       asp-action="MyProducts"
                       class="btn btn-primary">
                        My Products
                    </a>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Browse Products
                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- REQUEST COUNT -->
        <div class="alert alert-light border mb-4">

            <strong>@Model.Count()</strong>
            buy request(s) found.

        </div>

        <div class="row g-4">

            @foreach (var request in Model)
            {
                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body d-flex flex-column">

                            <!-- PRODUCT TITLE + STATUS -->
                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h4 class="fw-bold mb-0">
                                    @request.Product?.Title
                                </h4>

                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else if (request.Status == "Completed")
                                {
                                    <span class="badge bg-primary">
                                        Completed
                                    </span>
                                }
                                else if (request.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>
                                }

                            </div>

                            <!-- PRICE -->
                            <h4 class="text-success fw-bold mb-3">
                                ₹@request.Product?.Price.ToString("N2")
                            </h4>

                            <!-- REQUEST INFORMATION -->
                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="text-muted">
                                        Buyer
                                    </span>

                                    <strong>
                                        @request.Buyer?.Name
                                    </strong>

                                </div>

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Request Date
                                    </span>

                                    <strong>
                                        @request.CreatedDate.ToString("dd-MM-yyyy")
                                    </strong>

                                </div>

                            </div>

                            <hr />

                            <!-- VIEW PRODUCT -->
                            @if (request.Product != null)
                            {
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@request.Product.ProductId"
                                   class="btn btn-outline-primary w-100 mb-3">
                                    View Product
                                </a>
                            }

                            <!-- PENDING ACTIONS -->
                            @if (request.Status == "Pending")
                            {
                                <div class="d-flex gap-2">

                                    <form asp-controller="Transaction"
                                          asp-action="Accept"
                                          asp-route-id="@request.TransactionId"
                                          method="post"
                                          class="flex-fill">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-success w-100">
                                            Accept
                                        </button>

                                    </form>

                                    <form asp-controller="Transaction"
                                          asp-action="Reject"
                                          asp-route-id="@request.TransactionId"
                                          method="post"
                                          class="flex-fill">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger w-100">
                                            Reject
                                        </button>

                                    </form>

                                </div>
                            }

                            <!-- COMPLETE TRANSACTION -->
                            @if (request.Status == "Accepted")
                            {
                                <form asp-controller="Transaction"
                                      asp-action="Complete"
                                      asp-route-id="@request.TransactionId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-primary w-100">
                                        Complete Transaction
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <!-- BOTTOM NAVIGATION -->
    <div class="mt-4">

        <a asp-controller="Product"
           asp-action="MyProducts"
           class="btn btn-outline-secondary">
            ← My Products
        </a>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Browse Products
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Home
        </a>

    </div>

</div>