<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - StudentMarketplaceSystem
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/StudentMarketplaceSystem.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ========================= -->
    <!-- NAVIGATION BAR -->
    <!-- ========================= -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container">

                <!-- WEBSITE NAME -->

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Student Marketplace

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION CONTENT -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <!-- ========================= -->
                    <!-- LEFT SIDE -->
                    <!-- ========================= -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {


                            <!-- BROWSE PRODUCTS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Product"
                                   asp-action="Index">

                                    Browse

                                </a>

                            </li>


                            <!-- SELL ITEM -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Product"
                                   asp-action="Create">

                                    Sell an Item

                                </a>

                            </li>


                            <!-- MY PRODUCTS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Product"
                                   asp-action="MyProducts">

                                    My Products

                                </a>

                            </li>


                            <!-- WISHLIST -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Wishlist"
                                   asp-action="Index">

                                    Wishlist

                                </a>

                            </li>


                            <!-- MY ORDERS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Transaction"
                                   asp-action="MyOrders">

                                    My Orders

                                </a>

                            </li>


                            <!-- BUY REQUESTS -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Transaction"
                                   asp-action="Requests">

                                    Buy Requests

                                </a>

                            </li>

                        }

                    </ul>


                    <!-- ========================= -->
                    <!-- RIGHT SIDE -->
                    <!-- ========================= -->

                    <ul class="navbar-nav">


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {


                            <!-- USER NAME -->

                            <li class="nav-item">

                                <span class="nav-link text-muted">

                                    Hello,
                                    @User.Identity.Name

                                </span>

                            </li>


                            <!-- PROFILE -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Profile">

                                    Profile

                                </a>

                            </li>


                            <!-- ========================= -->
                            <!-- ADMIN MENU -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Admin"))
                            {

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Admin

                                    </a>


                                    <ul class="dropdown-menu dropdown-menu-end">


                                        <!-- DASHBOARD -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Dashboard"
                                               asp-action="Index">

                                                Admin Dashboard

                                            </a>

                                        </li>


                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>


                                        <!-- USERS -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Index">

                                                Manage Users

                                            </a>

                                        </li>


                                        <!-- PRODUCTS -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Products"
                                               asp-action="Index">

                                                Manage Products

                                            </a>

                                        </li>


                                        <!-- REPORTS -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Reports"
                                               asp-action="Index">

                                                Reports

                                            </a>

                                        </li>


                                        <!-- STATISTICS -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Statistics"
                                               asp-action="Index">

                                                Statistics

                                            </a>

                                        </li>

                                    </ul>

                                </li>

                            }


                            <!-- LOGOUT -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link btn btn-link">

                                        Logout

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {


                            <!-- REGISTER -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>


                            <!-- LOGIN -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <main role="main"
          class="container py-4">

        @RenderBody()

    </main>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer class="border-top text-muted py-3 mt-4">

        <div class="container text-center">

            &copy; 2026 - StudentMarketplaceSystem

            |

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>