@model StudentMarketplaceSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <!-- REGISTRATION CARD -->
            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <!-- HEADER -->
                    <div class="text-center mb-4">

                        <h1 class="fw-bold">
                            Student Registration
                        </h1>

                        <p class="text-muted">
                            Create your Student Marketplace account.
                        </p>

                    </div>

                    <!-- VALIDATION SUMMARY -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- NAME -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- EMAIL -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Password must meet the required security rules.
                            </small>

                        </div>

                        <!-- CONFIRM PASSWORD -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Re-enter your password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- BRANCH -->
                        <div class="mb-4">

                            <label asp-for="Branch"
                                   class="form-label fw-semibold">
                                Branch
                            </label>

                            <input asp-for="Branch"
                                   class="form-control"
                                   placeholder="Example: Computer Engineering" />

                            <span asp-validation-for="Branch"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- YEAR -->
                        <div class="mb-4">

                            <label asp-for="Year"
                                   class="form-label fw-semibold">
                                Year
                            </label>

                            <select asp-for="Year"
                                    class="form-select">

                                <option value="">
                                    -- Select Year --
                                </option>

                                <option value="1">
                                    1st Year
                                </option>

                                <option value="2">
                                    2nd Year
                                </option>

                                <option value="3">
                                    3rd Year
                                </option>

                                <option value="4">
                                    4th Year
                                </option>

                            </select>

                            <span asp-validation-for="Year"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- CONTACT NUMBER -->
                        <div class="mb-4">

                            <label asp-for="ContactNumber"
                                   class="form-label fw-semibold">
                                Contact Number
                            </label>

                            <input asp-for="ContactNumber"
                                   class="form-control"
                                   placeholder="Enter your contact number" />

                            <span asp-validation-for="ContactNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <hr class="my-4" />

                        <!-- REGISTER BUTTON -->
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Create Account
                        </button>

                    </form>

                    <hr class="my-4" />

                    <!-- LOGIN -->
                    <div class="text-center">

                        <p class="text-muted mb-2">
                            Already have an account?
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-primary">
                            Login Here
                        </a>

                    </div>

                </div>

            </div>

            <!-- BACK HOME -->
            <div class="text-center mt-3">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none">
                    ← Back to Home
                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}